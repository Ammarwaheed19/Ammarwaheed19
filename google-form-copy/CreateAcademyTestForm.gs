function createForm() {
  var form = FormApp.create(FORM_TITLE);
  form.setIsQuiz(true);

  // Student details
  form.addTextItem().setTitle('نام').setRequired(true);
  form.addTextItem().setTitle('گروپ نمبر/ نام').setRequired(true);
  var section = form.addMultipleChoiceItem().setTitle('سیکشن').setRequired(true);
  section.setChoices([
    section.createChoice('پلگ اینڈ پلے'),
    section.createChoice('رومن')
  ]);

  form.addSectionHeaderItem()
      .setTitle('اکیڈمی ٹیسٹ')
      .setHelpText('اللہ کو حاضرو ناظر جانتے ہوئے ٹیسٹ دیں');

  // Test questions
  QUESTIONS.forEach(function (q) {
    if (q.image) {
      var blob = Utilities.newBlob(Utilities.base64Decode(IMAGES[q.image]), 'image/jpeg', q.image + '.jpg');
      form.addImageItem().setImage(blob);
    }
    var item = form.addMultipleChoiceItem().setTitle(q.title).setRequired(true).setPoints(POINTS);
    item.setChoices(q.options.map(function (opt, i) {
      return item.createChoice(opt, SET_ANSWER_KEY && i === q.correct);
    }));
  });

  Logger.log('EDIT link (for you):     ' + form.getEditUrl());
  Logger.log('Student link (to share): ' + form.getPublishedUrl());
}

